# =========================================================
# CUSTOMER & SALES DATA ANALYSIS PROJECT
# =========================================================
#
# OBJECTIVES:
# ✔ Identify most valuable customers
# ✔ Find products that sell best together
# ✔ Analyze highest sales regions
# ✔ Discover seasonal sales trends
# ✔ Analyze customer retention
#
# TECHNICAL REQUIREMENTS COVERED:
# ✔ pandas data manipulation
# ✔ Data merging/joining
# ✔ Multiple aggregations
# ✔ Pivot tables
# ✔ Professional visualizations
# ✔ Error handling
#
# REQUIRED LIBRARIES:
# pip install pandas matplotlib
#
# DATA FILES:
# customer_data.csv
# sales_data.csv
#
# =========================================================

# ---------------------------------------------------------
# IMPORT LIBRARIES
# ---------------------------------------------------------

import pandas as pd
import matplotlib.pyplot as plt

# ---------------------------------------------------------
# FILE CONFIGURATION
# ---------------------------------------------------------

CUSTOMER_FILE = "customer_data.csv"
SALES_FILE = "sales_data.csv"

# ---------------------------------------------------------
# LOAD DATASETS
# ---------------------------------------------------------

try:
    customers_df = pd.read_csv(CUSTOMER_FILE)
    sales_df = pd.read_csv(SALES_FILE)

    print("✅ Datasets loaded successfully!\n")

except FileNotFoundError as e:
    print("❌ File not found:", e)
    exit()

except Exception as e:
    print("❌ Error loading datasets:", e)
    exit()

# ---------------------------------------------------------
# DATA EXPLORATION
# ---------------------------------------------------------

print("=" * 60)
print("📊 DATA EXPLORATION")
print("=" * 60)

print("\n🔹 CUSTOMER DATASET:")
print(customers_df.head())

print("\n🔹 SALES DATASET:")
print(sales_df.head())

print("\n🔹 SALES DATASET SHAPE:")
print(sales_df.shape)

print("\n🔹 MISSING VALUES:")
print(sales_df.isnull().sum())

# ---------------------------------------------------------
# DATA CLEANING
# ---------------------------------------------------------

print("\n🧹 CLEANING DATA...\n")

# Remove duplicates
customers_df = customers_df.drop_duplicates()
sales_df = sales_df.drop_duplicates()

# Handle missing values
sales_df = sales_df.fillna(0)

# Convert date column safely
if "OrderDate" in sales_df.columns:
    sales_df["OrderDate"] = pd.to_datetime(
        sales_df["OrderDate"],
        errors="coerce"
    )

# ---------------------------------------------------------
# CREATE REVENUE COLUMN
# ---------------------------------------------------------

if "Quantity" in sales_df.columns and "Price" in sales_df.columns:

    sales_df["Revenue"] = (
        sales_df["Quantity"] * sales_df["Price"]
    )

# ---------------------------------------------------------
# MERGE DATASETS
# ---------------------------------------------------------

# ---------------------------------------------------------
# SAFE DATASET MERGING
# ---------------------------------------------------------

# ---------------------------------------------------------
# MERGE DATASETS SAFELY
# ---------------------------------------------------------

try:

    # Print columns to identify correct names
    print("\nSALES DATASET COLUMNS:")
    print(sales_df.columns.tolist())

    print("\nCUSTOMER DATASET COLUMNS:")
    print(customers_df.columns.tolist())

    # -----------------------------------------------------
    # UPDATE THESE COLUMN NAMES IF NEEDED
    # -----------------------------------------------------

    sales_customer_col = "Customer_ID"
    customer_customer_col = "Customer_ID"

    # Merge datasets
    merged_df = pd.merge(
        sales_df,
        customers_df,
        left_on=sales_customer_col,
        right_on=customer_customer_col,
        how="left"
    )

    print("\n✅ Datasets merged successfully!")

except KeyError as e:

    print("\n❌ COLUMN ERROR:", e)

    print("\n👉 Check your column names carefully.")
    print("Update these variables:")
    print("sales_customer_col")
    print("customer_customer_col")

    exit()

except Exception as e:

    print("\n❌ Error merging datasets:", e)

    exit()
    
# ---------------------------------------------------------
# CUSTOMER ANALYSIS
# ---------------------------------------------------------

print("=" * 60)
print("👥 CUSTOMER ANALYSIS")
print("=" * 60)

# Most Valuable Customers
top_customers = (
    merged_df.groupby("Customer_ID")["Revenue"]
    .sum()
    .sort_values(ascending=False)
    .head(10)
)

print("\n🏆 TOP 10 MOST VALUABLE CUSTOMERS:\n")
print(top_customers)

# Customer Lifetime Value
customer_ltv = (
    merged_df.groupby("Customer_ID")["Revenue"]
    .agg(["sum", "mean", "count"])
)

print("\n💰 CUSTOMER LIFETIME VALUE:\n")
print(customer_ltv.head())

# ---------------------------------------------------------
# REGIONAL SALES ANALYSIS
# ---------------------------------------------------------

print("=" * 60)
print("🌍 REGIONAL SALES ANALYSIS")
print("=" * 60)

if "Region" in merged_df.columns:

    regional_sales = (
        merged_df.groupby("Region")["Revenue"]
        .sum()
        .sort_values(ascending=False)
    )

    print("\n📍 SALES BY REGION:\n")
    print(regional_sales)

# ---------------------------------------------------------
# PRODUCT ANALYSIS
# ---------------------------------------------------------

print("=" * 60)
print("🛒 PRODUCT ANALYSIS")
print("=" * 60)

# Best-selling products
best_products = (
    merged_df.groupby("Product")["Quantity"]
    .sum()
    .sort_values(ascending=False)
)

print("\n🔥 BEST-SELLING PRODUCTS:\n")
print(best_products.head(10))

# ---------------------------------------------------------
# PRODUCTS SOLD TOGETHER
# ---------------------------------------------------------

print("=" * 60)
print("🔗 PRODUCTS SOLD TOGETHER")
print("=" * 60)

if "Product" in merged_df.columns:

    basket = (
        merged_df.groupby("Product")["Product"]
        .apply(list)
    )

    print("\n🛍 SAMPLE PRODUCT COMBINATIONS:\n")
    print(basket.head())

# ---------------------------------------------------------
# SEASONAL TREND ANALYSIS
# ---------------------------------------------------------

print("=" * 60)
print("📈 SEASONAL TREND ANALYSIS")
print("=" * 60)

if "OrderDate" in merged_df.columns:

    merged_df["Month"] = (
        merged_df["OrderDate"]
        .dt.month_name()
    )

    monthly_sales = (
        merged_df.groupby("Month")["Revenue"]
        .sum()
    )

    print("\n📅 MONTHLY SALES:\n")
    print(monthly_sales)

# ---------------------------------------------------------
# PIVOT TABLE ANALYSIS
# ---------------------------------------------------------

print("=" * 60)
print("📊 PIVOT TABLE ANALYSIS")
print("=" * 60)

pivot_table = pd.pivot_table(
    merged_df,
    values="Revenue",
    index="Region" if "Region" in merged_df.columns else "Customer_ID",
    columns="Product",
    aggfunc="sum",
    fill_value=0
)

print("\n📌 REVENUE PIVOT TABLE:\n")
print(pivot_table.head())

# ---------------------------------------------------------
# CUSTOMER RETENTION ANALYSIS
# ---------------------------------------------------------

print("=" * 60)
print("🔄 CUSTOMER RETENTION ANALYSIS")
print("=" * 60)

repeat_customers = (
    merged_df.groupby("Customer_ID")["Product"]
    .nunique()
)

retained_customers = (
    repeat_customers[repeat_customers > 1]
    .count()
)

total_customers = merged_df["Customer_ID"].nunique()

retention_rate = (
    retained_customers / total_customers
) * 100

print(f"\n📌 CUSTOMER RETENTION RATE: {retention_rate:.2f}%")

# ---------------------------------------------------------
# VISUALIZATIONS
# ---------------------------------------------------------

print("\n📊 GENERATING VISUALIZATIONS...\n")

# =========================================================
# CHART 1: BAR CHART
# TOP PRODUCTS BY REVENUE
# =========================================================

product_revenue = (
    merged_df.groupby("Product")["Revenue"]
    .sum()
    .sort_values(ascending=False)
    .head(10)
)

plt.figure(figsize=(10, 6))

ax = product_revenue.plot(kind="bar")

plt.title("Top Products by Revenue")
plt.xlabel("Products")
plt.ylabel("Revenue")

plt.ticklabel_format(style='plain', axis='y')

plt.xticks(rotation=45)

# Revenue labels
for i, value in enumerate(product_revenue):

    ax.text(
        i,
        value,
        f'₹{value:,.0f}',
        ha='center',
        va='bottom'
    )

plt.tight_layout()
plt.show()

# =========================================================
# CHART 2: PIE CHART
# REGIONAL SALES DISTRIBUTION
# =========================================================

if "Region" in merged_df.columns:

    regional_sales = (
        merged_df.groupby("Region")["Revenue"]
        .sum()
    )

    labels = [
        f"{region} (₹{sales:,.0f})"
        for region, sales in regional_sales.items()
    ]

    plt.figure(figsize=(8, 8))

    plt.pie(
        regional_sales,
        labels=labels,
        autopct="%1.1f%%"
    )

    plt.title("Regional Sales Distribution")

    plt.tight_layout()
    plt.show()

# =========================================================
# CHART 3: LINE CHART
# MONTHLY SALES TREND
# =========================================================

if "OrderDate" in merged_df.columns:

    monthly_trend = (
        merged_df.groupby("Month")["Revenue"]
        .sum()
    )

    plt.figure(figsize=(10, 5))

    ax = monthly_trend.plot(
        kind="line",
        marker="o"
    )

    plt.title("Monthly Revenue Trend")
    plt.xlabel("Month")
    plt.ylabel("Revenue")

    plt.ticklabel_format(style='plain', axis='y')

    plt.grid(True)

    # Revenue labels
    for i, value in enumerate(monthly_trend):

        ax.text(
            i,
            value,
            f'₹{value:,.0f}',
            ha='center',
            va='bottom'
        )

    plt.tight_layout()
    plt.show()

# =========================================================
# CHART 4: CUSTOMER DISTRIBUTION
# =========================================================

top_customers_chart = (
    merged_df.groupby("Customer_ID")["Revenue"]
    .sum()
    .sort_values(ascending=False)
    .head(10)
)

plt.figure(figsize=(10, 5))

top_customers_chart.plot(kind="barh")

plt.title("Top 10 Customers by Revenue")
plt.xlabel("Revenue")
plt.ylabel("Customer_ID")

plt.tight_layout()
plt.show()

# ---------------------------------------------------------
# BUSINESS INSIGHTS
# ---------------------------------------------------------

print("=" * 60)
print("📌 BUSINESS INSIGHTS")
print("=" * 60)

print(f"""
1. The most valuable customers contribute significantly to total revenue.

2. The highest-performing products generate the majority of sales revenue.

3. Regional analysis helps identify markets with the strongest business performance.

4. Seasonal trends reveal peak sales periods and customer buying behavior.

